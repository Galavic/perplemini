  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "overlayscrollbars": "^2.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "robot-heads": "^0.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Galavic/perplemini.git"
  },
  "homepage": "https://github.com/Galavic/perplemini#readme",
