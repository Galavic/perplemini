{
  "name": "perplemini",
  "version": "1.0.0",
  "description": "An open-source AI answer engine with native CLI research, streaming answers and cited sources.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js --production",
    "test:e2e": "playwright test",
    "icons:central": "node scripts/activate-central-icons.mjs"
  },
  "keywords": [
    "ai",
    "search",
    "opencode",
    "deepseek",
    "codex",
    "claude-code"
