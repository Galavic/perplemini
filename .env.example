PORT=3000
HOST=127.0.0.1
CLI_PROVIDER=codex
CLI_TIMEOUT_MS=180000
# Optional absolute executable/script paths if a CLI is not found in PATH.
CLI_CODEX_PATH=
CLI_CLAUDE_PATH=
CLI_OPENCODE_PATH=
# Leave blank to use the CLI's default model.
CLI_CODEX_MODEL=
CLI_CLAUDE_MODEL=
CLI_OPENCODE_MODEL=
# Web search uses the selected CLI's native tools and configuration.
# Install-time license for the optional Central Icons set. Never use VITE_ here.
CENTRAL_LICENSE_KEY=
